.vscode/

# OS
.DS_Store
Thumbs.db

# pytest / coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# KiCad -- local working/backup cruft (the checked-in project lives in
# hardware/kicad/: kicad.kicad_pro, .kicad_sch, .kicad_pcb, .kicad_prl only)
hardware/kicad/kicad-backups/
hardware/kicad/_autosave-*
hardware/kicad/*.lck
hardware/kicad/fp-info-cache
hardware/kicad/*.kicad_sch-bak
**/*.lck

